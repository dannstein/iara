# Base da API. Em dev e em produção (nginx) usamos caminho relativo /api
# para que o proxy resolva e não haja CORS. Para apontar direto ao backend,
# troque por http://localhost:8080/api.
VITE_API_URL=/api

# Tiles do mapa (OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Alvo do proxy do Vite em dev (somente dev). Default: http://localhost:8080
VITE_PROXY_TARGET=http://localhost:8080
